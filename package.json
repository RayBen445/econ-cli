{
  "name": "econlab",
  "version": "2.0.0",
  "private": true,
  "description": "EconLab ecosystem-grade developer terminal toolkit. Powered by Kontyra.",
  "main": "dist/cli/index.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "econ": "./bin/index.js",
    "econlab": "./bin/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node bin/index.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:patch": "npm version patch && npm run changelog",
    "release:minor": "npm version minor && npm run changelog",
    "release:major": "npm version major && npm run changelog",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "doctor": "node ./bin/index.js doctor"
  },
  "keywords": [
    "economics",
    "cli",
    "finance",
    "math",
    "developer-tooling",
    "terminal",
    "kontyra"
  ],
  "author": "Kontyra",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RayBen445/econ-cli.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "kontyra": {
    "poweredBy": "Powered by Kontyra",
    "aiReady": true,
    "aiImplemented": false
  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "csv-parser": "^3.2.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "figlet": "^1.11.0",
    "fs-extra": "^11.3.5",
    "gradient-string": "^2.0.2",
    "inquirer": "^9.3.8",
    "katex": "^0.16.45",
    "lodash": "^4.18.1",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "markdown-pdf": "^11.0.0",
    "mathjax": "^4.1.2",
    "mathjs": "^15.2.0",
    "ora": "^5.4.1",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "plotly.js-dist": "^3.5.1",
    "update-notifier": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/jest": "^29.5.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.17.6",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.3"
  }
}
